# ===== App =====
APP_ENV=development
APP_PORT=8000
APP_HOST=0.0.0.0
NGROK_URL=

# ===== Claude =====
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-4-5

# ===== Google =====
GOOGLE_API_KEY=
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_WORKSPACE_FOLDER_ID=
GOOGLE_APPS_SCRIPT_DEPLOYMENT_ID=
GOOGLE_APPS_SCRIPT_WEBAPP_URL=
GOOGLE_APPS_SCRIPT_WEBHOOK_SECRET=

# ===== Storage =====
# Local dev can keep ./data/... ; Zeabur should point this at a mounted persistent volume.
DATABASE_PATH=./data/shuangyun-agent.db
TRACE_EXPORT_DIR=./data/traces

# ===== Runtime =====
DEFAULT_CLIENT_TIMEZONE=Asia/Taipei
COMMITTEE_SCORE_THRESHOLD_PASS=8
COMMITTEE_SCORE_THRESHOLD_MINOR=6
COMMITTEE_SCORE_THRESHOLD_REWORK=4

# ===== Access Control =====
# 格式：alias:role:secret，多組以逗號分隔；至少一組 admin token
# 角色：viewer（只讀） / operator（一般寫入） / admin（admin 端點 + prompt 變更）
PLATFORM_ACCESS_TOKENS=jacky:admin:change-me-local-only

# ===== Cost Gate =====
# 每日預算上限（USD），超過後 dispatch 會 fail closed 回 429
DAILY_COST_BUDGET_USD=5
# Claude token 計費單價（USD per million tokens）
CLAUDE_INPUT_USD_PER_MTOK=3
CLAUDE_OUTPUT_USD_PER_MTOK=15

# ===== Integration tokens =====
OPENAI_API_KEY=
SHUANGYUN_GATEWAY_URL=http://localhost:8000
SHUANGYUN_GATEWAY_TOKEN=
